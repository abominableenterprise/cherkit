{
  "description": "SunsetChecker end to end: one launch with a fetch result and a cached body. `fetch.result` is `response` (an HTTP `status` with the body from `fetch.config`, a name in `configs` serialized back to JSON, or raw `fetch.text`), `timeout` (the source never answers within the checker's timeout) or `error` (the source fails). `cached` names a config, `cachedText` is a raw cached body, neither means no cache. The checker decides for `platform`, `installedVersion`, `osVersion` and `locale`. `decision` is upToDate, softUpdate or hardUpdate (with the prompt's `storeURL`); `cacheAfter` is `fetched` (the fetched body was saved) or `unchanged`. Only a 2xx body that parses is used and cached; every other path falls back to the cache, then to upToDate.",
  "configs": {
    "hard-ios": {
      "schemaVersion": 1,
      "ios": { "minimumVersion": "2.0.0", "latestVersion": "2.0.0", "storeURL": "https://apps.apple.com/app/id1" },
      "android": { "minimumVersion": "2.0.0", "latestVersion": "2.0.0", "storeURL": "https://play.google.com/store/apps/details?id=hard" }
    },
    "soft-ios": {
      "schemaVersion": 1,
      "ios": { "latestVersion": "1.5.0", "storeURL": "https://apps.apple.com/app/id2" },
      "android": { "latestVersion": "1.5.0", "storeURL": "https://play.google.com/store/apps/details?id=soft" }
    },
    "current": {
      "schemaVersion": 1,
      "ios": { "minimumVersion": "1.0.0", "latestVersion": "1.0.0", "storeURL": "https://apps.apple.com/app/id3" },
      "android": { "minimumVersion": "1.0.0", "latestVersion": "1.0.0", "storeURL": "https://play.google.com/store/apps/details?id=current" }
    },
    "android-only": {
      "schemaVersion": 1,
      "android": { "minimumVersion": "2.0.0", "storeURL": "https://play.google.com/store/apps/details?id=hard" }
    },
    "os-gated": {
      "schemaVersion": 1,
      "ios": { "minimumVersion": "2.0.0", "latestMinimumOS": "18.0", "storeURL": "https://apps.apple.com/app/id4" },
      "android": { "minimumVersion": "2.0.0", "latestMinimumOS": "35", "storeURL": "https://play.google.com/store/apps/details?id=gated" }
    },
    "schema-2": { "schemaVersion": 2, "ios": { "minimumVersion": "9.0.0", "storeURL": "https://apps.apple.com/app/id9" } }
  },
  "cases": [
    { "name": "fresh config, no cache: decide and cache it", "platform": "ios", "fetch": { "result": "response", "status": 200, "config": "hard-ios" }, "decision": "hardUpdate", "storeURL": "https://apps.apple.com/app/id1", "cacheAfter": "fetched" },
    { "name": "fresh config overrides a cached hard block", "platform": "ios", "fetch": { "result": "response", "status": 200, "config": "current" }, "cached": "hard-ios", "decision": "upToDate", "cacheAfter": "fetched" },
    { "name": "fresh config overrides a cached soft prompt with a hard block", "platform": "ios", "fetch": { "result": "response", "status": 200, "config": "hard-ios" }, "cached": "soft-ios", "decision": "hardUpdate", "storeURL": "https://apps.apple.com/app/id1", "cacheAfter": "fetched" },
    { "name": "fresh config with no block for this platform still wins and is cached", "platform": "ios", "fetch": { "result": "response", "status": 200, "config": "android-only" }, "cached": "hard-ios", "decision": "upToDate", "cacheAfter": "fetched" },
    { "name": "any 2xx counts", "platform": "ios", "fetch": { "result": "response", "status": 203, "config": "soft-ios" }, "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "fetched" },
    { "name": "timeout: use the cache", "platform": "ios", "fetch": { "result": "timeout" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "unchanged" },
    { "name": "timeout, no cache: upToDate", "platform": "ios", "fetch": { "result": "timeout" }, "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "network error: use the cache", "platform": "ios", "fetch": { "result": "error" }, "cached": "hard-ios", "decision": "hardUpdate", "storeURL": "https://apps.apple.com/app/id1", "cacheAfter": "unchanged" },
    { "name": "503 with a valid-looking body: ignored, use the cache", "platform": "ios", "fetch": { "result": "response", "status": 503, "config": "hard-ios" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "unchanged" },
    { "name": "404, no cache: upToDate", "platform": "ios", "fetch": { "result": "response", "status": 404, "config": "hard-ios" }, "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "304 is not a success", "platform": "ios", "fetch": { "result": "response", "status": 304, "config": "hard-ios" }, "cached": "current", "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "redirect status with a body is not a success", "platform": "ios", "fetch": { "result": "response", "status": 302, "config": "hard-ios" }, "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "200 with an empty body: use the cache", "platform": "ios", "fetch": { "result": "response", "status": 200, "text": "" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "unchanged" },
    { "name": "malformed body: not cached, use the cache", "platform": "ios", "fetch": { "result": "response", "status": 200, "text": "<html><body>Site maintenance</body></html>" }, "cached": "hard-ios", "decision": "hardUpdate", "storeURL": "https://apps.apple.com/app/id1", "cacheAfter": "unchanged" },
    { "name": "truncated body: not cached, use the cache", "platform": "ios", "fetch": { "result": "response", "status": 200, "text": "{\"schemaVersion\": 1, \"ios\": {\"minimumVersion\": \"2.0" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "unchanged" },
    { "name": "malformed body, no cache: upToDate and nothing cached", "platform": "ios", "fetch": { "result": "response", "status": 200, "text": "not json" }, "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "unknown schemaVersion: not cached, use the cache", "platform": "ios", "fetch": { "result": "response", "status": 200, "config": "schema-2" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://apps.apple.com/app/id2", "cacheAfter": "unchanged" },
    { "name": "no config at all: upToDate", "platform": "ios", "fetch": { "result": "error" }, "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "fetch failed and the cache is corrupt: upToDate", "platform": "ios", "fetch": { "result": "error" }, "cachedText": "{\"schemaVers", "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "malformed fetch and corrupt cache: upToDate", "platform": "ios", "fetch": { "result": "response", "status": 200, "text": "[]" }, "cachedText": "", "decision": "upToDate", "cacheAfter": "unchanged" },
    { "name": "OS below latestMinimumOS: no prompt, config still cached", "platform": "ios", "osVersion": "17.5", "fetch": { "result": "response", "status": 200, "config": "os-gated" }, "decision": "upToDate", "cacheAfter": "fetched" },
    { "name": "unparseable installed version: upToDate", "platform": "ios", "installedVersion": "dev-build", "fetch": { "result": "response", "status": 200, "config": "hard-ios" }, "decision": "upToDate", "cacheAfter": "fetched" },
    { "name": "android: fresh hard block", "platform": "android", "osVersion": "34", "fetch": { "result": "response", "status": 200, "config": "android-only" }, "decision": "hardUpdate", "storeURL": "https://play.google.com/store/apps/details?id=hard", "cacheAfter": "fetched" },
    { "name": "android: timeout uses the cache", "platform": "android", "osVersion": "34", "fetch": { "result": "timeout" }, "cached": "soft-ios", "decision": "softUpdate", "storeURL": "https://play.google.com/store/apps/details?id=soft", "cacheAfter": "unchanged" },
    { "name": "android: API level below latestMinimumOS gets no prompt", "platform": "android", "osVersion": "34", "fetch": { "result": "response", "status": 200, "config": "os-gated" }, "decision": "upToDate", "cacheAfter": "fetched" }
  ],
  "defaults": { "installedVersion": "1.0.0", "osVersion": "18.0", "locale": ["en-US"] }
}
