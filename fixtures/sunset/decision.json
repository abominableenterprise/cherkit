    { "name": "below minimum with build suffix: hard", "config": "standard", "platform": "ios", "appVersion": "1.1.9 (77)", "osVersion": "18.0", "languages": ["en-US"], "decision": "hardUpdate", "storeURL": "https://apps.apple.com/app/id123456789", "latestVersion": "1.4.0", "message": "Please update." },
