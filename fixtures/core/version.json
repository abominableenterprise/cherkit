{
  "description": "AppVersion contract. parse: input -> numeric components, or null when the input is malformed (callers fail open). compare: sign of a compared with b (-1, 0, 1); missing components count as 0 and suffixes are ignored.",
  "parse": [
    { "input": "1", "components": [1] },
    { "input": "1.2", "components": [1, 2] },
    { "input": "1.2.3", "components": [1, 2, 3] },
    { "input": "1.2.3.4", "components": [1, 2, 3, 4] },
    { "input": "0", "components": [0] },
    { "input": "10.20.30", "components": [10, 20, 30] },
    { "input": "1.02.003", "components": [1, 2, 3] },
    { "input": "999999999.0", "components": [999999999, 0] },
    { "input": "  1.2.3  ", "components": [1, 2, 3] },
    { "input": "\t1.2\n", "components": [1, 2] },
    { "input": "v1.2.3", "components": [1, 2, 3] },
    { "input": "V1.2.3", "components": [1, 2, 3] },
    { "input": " v2 ", "components": [2] },
    { "input": "1.2.3 (45)", "components": [1, 2, 3] },
    { "input": "1.2.3+45", "components": [1, 2, 3] },
    { "input": "1.2.3-beta", "components": [1, 2, 3] },
    { "input": "1.2.3-beta.2", "components": [1, 2, 3] },
    { "input": "v1.2-rc1+build.7", "components": [1, 2] },
    { "input": "1.2.3-", "components": [1, 2, 3] },
    { "input": "", "components": null },
    { "input": "   ", "components": null },
    { "input": "abc", "components": null },
    { "input": "v", "components": null },
    { "input": "vv1", "components": null },
    { "input": "v 1", "components": null },
    { "input": "1..2", "components": null },
    { "input": ".1", "components": null },
    { "input": "1.", "components": null },
    { "input": "1.2.", "components": null },
    { "input": "-1", "components": null },
    { "input": "1.-2", "components": null },
    { "input": "+1", "components": null },
    { "input": "1.2.3beta", "components": null },
    { "input": "1.2a", "components": null },
    { "input": "1,2", "components": null },
    { "input": "1.2.3(45)", "components": null },
    { "input": "1234567890", "components": null },
    { "input": "1.0000000000", "components": null },
    { "input": "99999999999999999999", "components": null },
    { "input": "(45)", "components": null },
    { "input": "١.٢", "components": null },
    { "input": "１.２", "components": null }
  ],
  "compare": [
    { "a": "1.2", "b": "1.2.0", "result": 0 },
    { "a": "1", "b": "1.0.0.0", "result": 0 },
    { "a": "1.2.3", "b": "1.2.3", "result": 0 },
    { "a": "1.2.3", "b": "1.2.4", "result": -1 },
    { "a": "1.2.4", "b": "1.2.3", "result": 1 },
    { "a": "1.10", "b": "1.9", "result": 1 },
    { "a": "1.9.9", "b": "1.10", "result": -1 },
    { "a": "2", "b": "1.99.99", "result": 1 },
    { "a": "1.2", "b": "1.2.0.1", "result": -1 },
    { "a": "1.2.0.1", "b": "1.2", "result": 1 },
    { "a": "0.9", "b": "1", "result": -1 },
    { "a": "1.02", "b": "1.2", "result": 0 },
    { "a": "v1.2.3", "b": "1.2.3", "result": 0 },
    { "a": "1.2.3 (45)", "b": "1.2.3 (46)", "result": 0 },
    { "a": "1.2.3-beta", "b": "1.2.3", "result": 0 },
    { "a": "1.2.3+45", "b": "1.2.4+1", "result": -1 },
    { "a": "999999999", "b": "999999998.999999999", "result": 1 }
  ]
}
